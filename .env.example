# Speech, search and fetch backends
PIPER_URL=http://localhost:5000
TTS_VOICE=fr_FR-siwis-medium
SEARXNG_URL=http://localhost:8888

# The registry of applications and the admin's accounts. Without a
# DATABASE_URL the registry is off and only SPEAK_* pairs speak.
DATABASE_URL=postgres://vvaves:vvaves@localhost:5432/vvaves?sslmode=disable
# Seals the applications' keys at rest: base64 of 32 random bytes,
# `openssl rand -base64 32`. Required with a DATABASE_URL.
REGISTRY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Pairs that predate the registry, "issuer:key" each. Optional.
SPEAK_KEYS=

# The admin web app. JWT_SECRET must be identical here and in the app: the
# web mints it from the Better Auth session, the app verifies it.
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:5273
JWT_SECRET=change-me-in-production
CORE_API_URL=http://localhost:8080
# Team sign-in on the admin console through the suite's identity provider.
# The client is vvaves-admin in urbangate; unset, the password form stays.
URBANGATE_ISSUER_URL=http://localhost:4444
URBANGATE_CLIENT_ID=vvaves-admin
URBANGATE_CLIENT_SECRET=
# Enrols customers at urbangate and mints their app keys; the core reads the
# same pair to verify those keys. The client is vvaves-provisioner.
URBANGATE_PROVISIONER_CLIENT_ID=vvaves-provisioner
URBANGATE_PROVISIONER_CLIENT_SECRET=
