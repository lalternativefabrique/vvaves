{
    "openapi": "3.0.0",
    "info": {
        "description": "Search, fetch, render and speak for every product, plus the admin API of the applications registry.\n\nThe web and speak routes answer at the root; the admin API is\nunder /api/v1, which is why no global base path is declared.",
        "title": "Vvaves",
        "contact": {},
        "version": "0.3.0"
    },
    "paths": {
        "/api/v1/admin/apps": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Every registered application, key withheld",
                "operationId": "listApps",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/registry.AppListDTO"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Admit an application and hand its key out once",
                "operationId": "registerApp",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/registry.RegisterRequest"
                            }
                        }
                    },
                    "description": "The issuer name the application signs as",
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/registry.CredentialsDTO"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/registry.ErrorDTO"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/admin/apps/{name}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "admin"
                ],
                "summary": "End an application's access at once",
                "operationId": "revokeApp",
                "parameters": [
                    {
                        "description": "Application name",
                        "name": "name",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
