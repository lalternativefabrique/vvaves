    "servers": [
        {
            "url": "/"
        }
    ],
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "apiKey",
                "name": "Authorization",
                "in": "header"
            },
            "ServiceKey": {
                "type": "apiKey",
                "name": "X-Vvaves-Key",
                "in": "header"
            }
        },
        "schemas": {
            "crawl.Job": {
                "type": "object",
                "properties": {
                    "created_at": {
                        "type": "string"
                    },
                    "error": {
                        "type": "string"
                    },
                    "failed": {
                        "type": "integer"
                    },
                    "id": {
                        "type": "string"
                    },
                    "pages": {
                        "type": "integer"
                    },
                    "scope": {
                        "$ref": "#/components/schemas/crawl.Scope"
                    },
