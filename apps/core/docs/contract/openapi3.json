                        "description": "crawl id",
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "first page to return",
                        "name": "offset",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "description": "how many pages to return",
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
