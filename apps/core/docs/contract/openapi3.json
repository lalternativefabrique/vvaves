{
    "openapi": "3.0.0",
    "info": {
        "description": "Read text aloud for every product, plus the admin API of the applications registry.\n\nThe speak routes answer at the root; the admin API is under\n/api/v1, which is why no global base path is declared.",
        "title": "Vvaves",
        "contact": {},
        "version": "0.3.0"
    },
    "paths": {
        "/api/v1/admin/apps": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Every registered application, key withheld",
                "operationId": "listApps",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/registry.AppListDTO"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Admit an application and hand its key out once",
                "operationId": "registerApp",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/registry.RegisterRequest"
                            }
                        }
                    },
                    "description": "The issuer name the application signs as",
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/registry.CredentialsDTO"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/registry.ErrorDTO"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/admin/apps/{name}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "admin"
                ],
                "summary": "End an application's access at once",
                "operationId": "revokeApp",
                "parameters": [
                    {
                        "description": "Application name",
                        "name": "name",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/registry.ErrorDTO"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/admin/apps/{name}/rotate": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Mint an application a new key; the old one works for a day",
                "operationId": "rotateAppKey",
                "parameters": [
                    {
                        "description": "Application name",
                        "name": "name",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/registry.CredentialsDTO"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/registry.ErrorDTO"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/registry.ErrorDTO"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "tags": [
                    "ops"
                ],
                "summary": "Liveness",
                "operationId": "healthz",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.healthResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/speak": {
            "post": {
                "security": [
                    {
                        "ServiceKey": []
                    },
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Answers audio bytes, not JSON. With stream=false the whole\nreading comes back with a Content-Length and ranges; with\nstream=true each piece is emitted as it is read, length-prefixed\nunder application/x-lalter-audio-frames.",
                "tags": [
                    "speak"
                ],
                "summary": "Read a text aloud, from the store when it is already there",
                "operationId": "speak",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/httpapi.speakRequest"
                            }
                        }
                    },
                    "description": "text to read",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "audio/mpeg": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "audio/mpeg": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "audio/mpeg": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "content": {
                            "audio/mpeg": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/speak/exists": {
            "post": {
                "security": [
                    {
                        "ServiceKey": []
                    },
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "speak"
                ],
                "summary": "Whether a reading is already stored, without reading its bytes",
                "operationId": "speakExists",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/httpapi.speakRequest"
                            }
                        }
                    },
                    "description": "reading to look for",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.existsResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/speak/pregenerate": {
            "post": {
                "security": [
                    {
                        "ServiceKey": []
                    },
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "For a text expected to be heard more than once. It holds a\nsynthesis slot, so prefer /speak/prime for a text that may never\nbe played. Takes an application key.",
                "tags": [
                    "speak"
                ],
                "summary": "Read a whole text ahead of time and keep it",
                "operationId": "pregenerateSpeak",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/httpapi.speakRequest"
                            }
                        }
                    },
                    "description": "text to read in full",
                    "required": true
                },
                "responses": {
                    "202": {
                        "description": "Accepted"
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/speak/prime": {
            "post": {
                "security": [
                    {
                        "ServiceKey": []
                    },
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Answers 202 without waiting: nobody is listening yet. Takes an\napplication key — a browser signature is good for /speak alone.",
                "tags": [
                    "speak"
                ],
                "summary": "Read a text's opening ahead of time, so the first listen starts at once",
                "operationId": "primeSpeak",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/httpapi.speakRequest"
                            }
                        }
                    },
                    "description": "text whose opening to read",
                    "required": true
                },
                "responses": {
                    "202": {
                        "description": "Accepted"
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/httpapi.errorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "apiKey",
                "name": "Authorization",
                "in": "header"
            },
            "ServiceKey": {
                "type": "apiKey",
                "name": "X-Vvaves-Key",
                "in": "header"
            }
        },
        "schemas": {
            "httpapi.errorResponse": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                }
            },
            "httpapi.existsResponse": {
                "type": "object",
                "properties": {
                    "ready": {
                        "type": "boolean"
                    }
                }
            },
            "httpapi.healthResponse": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    }
                }
            },
            "httpapi.speakRequest": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "scope": {
                        "description": "Scope and ID name where a reading is kept. Both optional: an ID lets a\ncaller prime a reading before anyone asks for it, since priming means\nnaming ahead of time what will be listened to. Without one the reading\nis still cached, keyed by the text alone — a second listen of the same\nwords finds it, which no caller has to opt into.",
                        "type": "string"
                    },
                    "stream": {
                        "type": "boolean"
                    },
                    "text": {
                        "type": "string"
                    }
                }
            },
            "registry.AppDTO": {
                "type": "object",
                "properties": {
                    "active": {
                        "type": "boolean"
                    },
                    "created_at": {
                        "type": "string"
                    },
                    "grace_until": {
                        "type": "string"
                    },
                    "last4": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "revoked_at": {
                        "type": "string"
                    },
                    "rotated_at": {
                        "type": "string"
                    }
                }
            },
            "registry.AppListDTO": {
                "type": "object",
                "properties": {
                    "apps": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/registry.AppDTO"
                        }
                    }
                }
            },
            "registry.CredentialsDTO": {
                "type": "object",
                "properties": {
                    "grace_until": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                }
            },
            "registry.ErrorDTO": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string"
                    }
                }
            },
            "registry.RegisterRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    }
                }
            }
        }
    }
}