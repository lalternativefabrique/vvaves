# web image — the admin, a TanStack Start SSR app behind a small Node server
FROM node:22-bookworm AS build
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate
WORKDIR /src
ENV CI=true
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json ./apps/web/package.json
COPY lib/front/package.json ./lib/front/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web ./apps/web
COPY lib/front ./lib/front
RUN pnpm --filter @vvaves/web build
RUN pnpm deploy --filter @vvaves/web --prod --frozen-lockfile /prod

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /prod/node_modules ./node_modules
# TanStack Start writes dist/, a fetch handler; server.js is what listens.
COPY --from=build /src/apps/web/dist ./dist
COPY --from=build /src/apps/web/server.js ./server.js
COPY --from=build /src/apps/web/package.json ./package.json
# The server runs under plain node, so the npm the base image bundles is dead
# weight, and it is where every HIGH/CRITICAL the publish scan blocks on lives:
# tar, pacote, sigstore, ip-address, brace-expansion, picomatch are npm's own.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
 && groupadd -g 10001 app && useradd -u 10001 -g app -M -s /usr/sbin/nologin app
# node:22-bookworm-slim ships libpcre2-8-0 10.42-1; bookworm-security fixes
# CVE-2026-86145 and CVE-2026-89161 in 10.42-1+deb12u1, the one pair the
# publish scan (HIGH, fixed only) holds against this image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpcre2-8-0 \
 && rm -rf /var/lib/apt/lists/*
USER 10001:10001
ENV PORT=5273
EXPOSE 5273
CMD ["node", "server.js"]
